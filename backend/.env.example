# Server
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
# For production on Render, set this to your Vercel frontend URL:
# e.g. https://stark-wallet.vercel.app (can be comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:5173

# Database
DATABASE_URL="file:./dev.db"

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Keep-Alive (Render injects this automatically in production — do NOT set manually)
# RENDER_EXTERNAL_URL=https://your-app.onrender.com

